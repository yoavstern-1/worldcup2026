# Copy this file to .dev.vars and fill in real values.
# .dev.vars is gitignored and must NEVER be committed.
#
# Production uses Cloudflare Worker secrets instead:
#   wrangler secret put GEMINI_KEYS
#   wrangler secret put FOOTBALL_API_KEY

GEMINI_KEYS=key1,key2,key3
FOOTBALL_API_KEY=your-football-data-org-key
